rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only your verified Google account counts as the owner.
    // Replace this placeholder with the owner email before publishing these rules.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'YOUR_OWNER_EMAIL';
    }

    function validProject(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.categoryRef is path
        && exists(d.categoryRef)
        && get(d.categoryRef).data.name is string
        && d.description is string && d.description.size() <= 2000
        && d.tags is list && d.tags.size() <= 20
        && d.link is string && d.link.size() <= 500
        && d.imageUrl is string && d.imageUrl.size() <= 500
        && d.createdAt is number
        && d.featured is bool
        && (d.year == null || (d.year is int && d.year >= 1900 && d.year <= 2100));
    }

    match /projects/{projectId} {
      allow read: if true;                       // everyone can view
      allow create, update: if isOwner() && validProject(request.resource.data);
      allow delete: if isOwner();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is number;
      allow delete: if false;
    }
  }
}
